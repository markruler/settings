{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(*)",
      "WebFetch(domain:*)",
      "Bash(*)"
    ],
    "deny": [
      "Read(credentials)",
      "Read(*.pem)",
      "Read(*.pub)",
      "Read(*.key)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  }
}
