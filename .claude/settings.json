{
  "permissions": {
    "deny": [
      "Read(credentials)",
      "Read(*.pem)",
      "Read(*.pub)",
      "Read(*.key)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipWorkflowUsageWarning": true,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "theme": "dark",
  "language": "korean",
  "enabledPlugins": {
    "aws-core@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
